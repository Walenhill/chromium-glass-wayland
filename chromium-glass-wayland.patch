+  mixer[kColorLocationBarBackground] = {kGlassOmnibox};
+  mixer[kColorLocationBarBackgroundHovered] = {kGlassOmniboxHovered};
+  mixer[kColorOmniboxResultsBackground] = {kGlassOmnibox};
+  mixer[kColorOmniboxResultsBackgroundHovered] = {
