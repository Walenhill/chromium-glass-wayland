+void AddGlassColorMixer(ui::ColorProvider* provider) {
+  if (!features::IsGlassFrameEnabled()) {
+    return;
+  }
+
+  // This mixer intentionally runs after Material, native, custom-theme, and
+  // app-controller mixers so their opaque recipes cannot flatten GlassFrame.
+  ui::ColorMixer& mixer = provider->AddMixer();
+  constexpr SkColor kGlassBase =
+      SkColorSetARGB(0x9A, 0x1A, 0x1C, 0x20);
+  constexpr SkColor kGlassActiveTab =
+      SkColorSetARGB(0x24, 0xFF, 0xFF, 0xFF);
+  constexpr SkColor kGlassTabHover =
+      SkColorSetARGB(0x12, 0xFF, 0xFF, 0xFF);
+  constexpr SkColor kGlassOmnibox =
+      SkColorSetARGB(0x48, 0x10, 0x12, 0x16);
+  constexpr SkColor kGlassOmniboxHovered =
+      SkColorSetARGB(0x58, 0x10, 0x12, 0x16);
+  constexpr SkColor kGlassOmniboxResultHover =
+      SkColorSetARGB(0x18, 0xFF, 0xFF, 0xFF);
+  constexpr SkColor kGlassPanel =
+      SkColorSetARGB(0xB8, 0x1C, 0x1E, 0x22);
+  constexpr SkColor kGlassPopup =
+      SkColorSetARGB(0xCC, 0x20, 0x22, 0x26);
+  constexpr SkColor kGlassMenu =
+      SkColorSetARGB(0x92, 0x20, 0x22, 0x26);
+
+  // Frame and toolbar are the only full glass surfaces. Child controls below
+  // use lightweight overlays so their alpha does not stack into dark blocks.
+  mixer[ui::kColorFrameActive] = {kGlassBase};
+  mixer[ui::kColorFrameInactive] = {kGlassBase};
+  mixer[kColorToolbar] = {kGlassBase};
+  mixer[kColorBookmarkBarBackground] = {SK_ColorTRANSPARENT};
+
+  mixer[kColorTabBackgroundInactiveFrameActive] = {SK_ColorTRANSPARENT};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {SK_ColorTRANSPARENT};
+  mixer[kColorTabBackgroundInactiveHoverFrameActive] = {kGlassTabHover};
+  mixer[kColorTabBackgroundInactiveHoverFrameInactive] = {kGlassTabHover};
+  mixer[kColorTabBackgroundSelectedFrameActive] = {kGlassTabHover};
+  mixer[kColorTabBackgroundSelectedFrameInactive] = {kGlassTabHover};
+  mixer[kColorTabBackgroundSelectedHoverFrameActive] = {kGlassActiveTab};
+  mixer[kColorTabBackgroundSelectedHoverFrameInactive] = {kGlassActiveTab};
+  mixer[kColorTabBackgroundActiveFrameActive] = {kGlassActiveTab};
+  mixer[kColorTabBackgroundActiveFrameInactive] = {kGlassActiveTab};
+  mixer[kColorTabStrokeFrameActive] = {SK_ColorTRANSPARENT};
+  mixer[kColorTabStrokeFrameInactive] = {SK_ColorTRANSPARENT};
+  mixer[kColorToolbarTopSeparatorFrameActive] = {SK_ColorTRANSPARENT};
+  mixer[kColorToolbarTopSeparatorFrameInactive] = {SK_ColorTRANSPARENT};
+
+  mixer[kColorNewTabButtonBackgroundFrameActive] = {SK_ColorTRANSPARENT};
+  mixer[kColorNewTabButtonBackgroundFrameInactive] = {SK_ColorTRANSPARENT};
+  mixer[kColorNewTabButtonCRBackgroundFrameActive] = {SK_ColorTRANSPARENT};
+  mixer[kColorNewTabButtonCRBackgroundFrameInactive] = {
+      SK_ColorTRANSPARENT};
+  mixer[kColorTabSearchButtonBackground] = {SK_ColorTRANSPARENT};
+  mixer[kColorTabSearchButtonIconBackground] = {SK_ColorTRANSPARENT};
+
+  mixer[kColorToolbarBackgroundSubtleEmphasis] = {kGlassOmnibox};
+  mixer[kColorToolbarBackgroundSubtleEmphasisHovered] = {
